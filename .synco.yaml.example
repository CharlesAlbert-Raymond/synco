# Synco local config (per-repo)
# Place as .synco.yaml in your repo root.
# Local values override the global config (~/.config/synco/config.yaml).

# Directory for worktrees, relative to repo root (default: ".worktrees")
worktree_dir: ".worktrees"

# Script to run inside the tmux session after worktree creation.
# Receives SYNCO_BRANCH and SYNCO_WORKTREE_PATH as env vars.
on_create: "./scripts/setup-worktree.sh"

# Script to run before worktree removal.
# Receives SYNCO_BRANCH and SYNCO_WORKTREE_PATH as env vars.
on_destroy: "./scripts/cleanup-worktree.sh"

# Worktree creation profiles control how much setup runs for each new worktree.
# If omitted, creation uses the built-in dev behavior: create a tmux session and run on_create.
# default_creation_profile: dev
# creation_profiles:
#   inspect:
#     create_session: false
#     run_on_create: false
#   dev:
#     create_session: true
#     run_on_create: true
#   agent:
#     create_session: true
#     run_on_create: true
#     bootstrap: 'claude --dangerously-skip-permissions "Work on {{branch}} in {{worktree_path}}"'

# Automatically delete the git branch when removing a worktree (default: false).
# Can be toggled per-deletion in the confirm dialog with 'b'.
auto_delete_branch: false

# Aliases give worktrees a human-friendly display name in the sidebar.
# Map branch names to short labels.
aliases:
  main: "Main"
  feature/my-branch: "My Feature"

# Notifications when an agent goes silent (no pane output for N seconds).
# The sidebar shows a red dot, and optionally plays a sound / system notification.
# notifications:
#   enabled: true
#   silence_seconds: 10       # seconds of no output before triggering
#   bell: true                # terminal bell (\a)
#   system_notification: true # macOS Notification Center
#   sound: "Glass"            # macOS sound name
#   on_silence: ""            # custom shell command, receives SYNCO_BRANCH and SYNCO_SESSION env vars
